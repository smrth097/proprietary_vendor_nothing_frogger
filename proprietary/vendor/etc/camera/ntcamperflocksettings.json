{
  "ProcessConfig": [
    {
      // camera_resume, camera apk前台运行场景
      "CameraScene": "CameraResume",
      "TargetCpus": "0-3",
      "Description": "Foreground running: ntcam-algo cpuset on little_cores"
    },
    {
      // first_preview for extend CameraScene
      "CameraScene": "CameraFirstPreview",
      "TargetCpus": "0-7",
    },
    {
      //camera_gallery的场景，apk下发camera_gallery=1，表示进入这个场景
      "CameraScene": "CameraGallery",
      "TargetCpus": "0-7", //这里配置自己想要绑定的CPU
      "Description": "Gallery mode: ntcam-algo cpuset config"
    },
    {
      //camera_gallery的场景，apk下发camera_gallery=1，表示进入这个场景
      "CameraScene": "CameraGallery",
      "TargetCpus": "0-7", //这里配置自己想要绑定的CPU
      "Description": "Gallery mode: ntcam-algo cpuset config"
    },
    {
      // camera_pause, camera apk后台运行场景
      "CameraScene": "CameraPause",
      "TargetCpus": "0-3",
      "Description": "Background running: ntcam-algo cpuset on all cores"
    },
    {
      // 录像模式1：普通录像（StreamConfigModeNormalVideo）
      "CameraScene": "CameraNormalVideo",
      "Description": "Normal video recording: different FPS map to different CPU cores",
      "FpsConfig": [
        {
          "Fps": [30],
          "TargetCpus": "0-3",
          "Description": "Normal video 30fps: bind to all cores (0-7) for balanced performance"
        },
        {
          "Fps": [60, 120],
          "TargetCpus": "0-1",
          "Description": "Normal video 60,120fps: bind to little_cores (0-1) for high frame rate stability"
        }
      ]
    },
    {
      // 录像模式2：慢动作录像（StreamConfigModeConstrainedHighSpeed）
      "CameraScene": "CameraHighSpeedVideo",
      "Description": "High speed video recording: different FPS map to different CPU cores",
      "FpsConfig": [
        {
          "Fps": [60, 120, 240],
          "TargetCpus": "0-1",
          "Description": "High-speed video 60,120,240fps: bind to little_cores (0-1) for balanced load"
        },
        {
          "Fps": [480],
          "TargetCpus": "0-1",
          "Description": "High-speed video 480fps: bind to little_cores (0-1) for high load processing"
        }
      ]
    },
    {
      // 录像模式3：延时摄影（StreamConfigModeTimeLapse）
      "CameraScene": "CameraTimeLapseVideo",
      "Description": "Time lapse video recording: different FPS map to different CPU cores",
      "FpsConfig": [
        {
          "Fps": [30],
          "TargetCpus": "0-1",
          "Description": "Time lapse video 30fps: bind to all cores (0-1) for balanced performance"
        }
      ]
    },
  ],
